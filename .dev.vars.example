# Секретні значення для локального запуску (`npx wrangler dev`).
# Скопіюйте цей файл у .dev.vars і підставте свої значення.
# Файл .dev.vars у .gitignore — у репозиторій не потрапляє.

# Токен до Journal API коледжу.
# Якщо задати тут — він матиме пріоритет над токеном у worker.js.
JOURNAL_API_TOKEN=

# Приватний ключ VAPID для web push (base64url, 32 байти).
# Згенерувати пару: npm run vapid:gen
# У production цей ключ треба покласти в секрет воркера:
#   npx wrangler secret put VAPID_PRIVATE_KEY
VAPID_PRIVATE_KEY=
